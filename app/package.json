{
  "name": "card-poker-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "sync-idl": "cp -f ../target/idl/card_poker.json src/idl/ 2>/dev/null; cp -f ../target/types/card_poker.ts src/idl/ 2>/dev/null; true",
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "setup-devnet": "tsx scripts/setup-devnet.ts",
    "e2e-devnet": "tsx scripts/e2e-devnet.ts"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.32.1",
    "@magicblock-labs/ephemeral-rollups-sdk": "0.14.3",
    "@solana/spl-token": "^0.4.13",
    "@solana/web3.js": "^1.98.0",
    "bn.js": "^5.2.1",
    "buffer": "^6.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.6",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  },
  "license": "MIT"
}
